{
  "name": "@1930dev/opencode-usage",
  "version": "0.5.0",
  "description": "Usage tracking, budget percentages and model ranking for opencode — CLI plus a /usage TUI plugin",
  "type": "module",
  "bin": {
    "opencode-usage": "./dist/cli.js"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "preview": "bun run build && bun packages/plugin/preview.ts",
    "prepublishOnly": "bun run build && bun test --coverage && tsc --noEmit",
    "coverage": "bun test --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1930-dev/opencode-usage.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "cost",
    "budget",
    "quota",
    "tokens",
    "llm"
  ],
  "author": "Agu Rodríguez <me@agu.uy>",
  "license": "MIT",
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "latest"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": "./dist/plugin.js",
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/1930-dev/opencode-usage/issues"
  },
  "homepage": "https://github.com/1930-dev/opencode-usage#readme"
}
